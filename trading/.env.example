# ==============================================
# Trading Service 配置文件示例
# 复制此文件为 .env 并填写实际值
# ==============================================

# Hyperliquid API 配置
HYPERLIQUID_PRIVATE_KEY=your-private-key-here
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_TESTNET=false

# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading123
POSTGRES_DATABASE=autotrading

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# 跟单机器人配置
BOT_USER_ID=1
BOT_CHECK_INTERVAL=0.1
BOT_RELOAD_INTERVAL=60.0

# API 服务配置
API_KEY=your-api-key-here
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs
