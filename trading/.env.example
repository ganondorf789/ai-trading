# ==============================================
# Trading Service 配置文件示例
# 复制此文件为 .env 并填写实际值
# ==============================================

# Hyperliquid API 配置
HYPERLIQUID_PRIVATE_KEY=your-private-key-here

# 跟单机器人配置
BOT_USER_ID=1
BOT_CHECK_INTERVAL=0.1
BOT_RELOAD_INTERVAL=60.0

# API 服务配置
API_KEY=your-api-key-here
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# gRPC 配置（连接到 services gRPC 服务器）
GRPC_ENABLED=true
GRPC_HOST=localhost
GRPC_PORT=50051
